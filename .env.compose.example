# =============================================================================
# docker-compose.yml tunables. Copy to ".env" next to docker-compose.yml:
#     cp .env.compose.example .env
# then fill in the secrets. Compose reads ./.env automatically.
# =============================================================================

# --- Chain node (autheo_2127-1) ---------------------------------------------
# One IP drives RPC :26657, REST :1317 and the WS endpoint.
CHAIN_NODE_IP=101.44.26.36

# --- Secrets (required; compose refuses to start if unset) ------------------
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
INDEXER_SECRET_KEY=autheo

# --- Postgres / Redis / RabbitMQ identities ---------------------------------
POSTGRES_USER=autheo
POSTGRES_DB=native_indexer_autheo
RABBITMQ_USER=autheo

# --- Host port mappings -----------------------------------------------------
# Infra ports bind to 127.0.0.1 only; app ports bind to all interfaces.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_PORT=15672
API_HOST_PORT=8010
INDEXER_HOST_PORT=8011
FRONTEND_HOST_PORT=3010

# --- App config -------------------------------------------------------------
# Comma-separated origins, or * for any. Include the frontend's public URL.
CORS_ALLOWED_ORIGINS=*
WS_CORS_ORIGINS=*
LOG_LEVEL=info
# 1 disables historical catch-up in the indexer (tip-only indexing).
CATCHUP_DISABLED=0

# --- Price feed -------------------------------------------------------------
# Empty = no live price; the api-service falls back to the hardcoded
# CURRENT_DEFAULT_COIN_PRICE constant. THEO is not listed on CoinMarketCap,
# so a key alone will not produce a real price.
COIN_MARKET_API_KEY=
