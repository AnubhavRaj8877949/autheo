# Server
PORT=3146
NODE_ENV=production
SECRET_KEY=change-me
SALT_VALUE=10

# Chain / RPC
ADDRESS_PREFIX=abc
CHAIN_NAME=abc
TOKEN_SYMBOL=ABC
TOKEN_CURRENCY=USD
PROJECT_NAME=abc
NATIVE_RPC_HTTP_URL=https://rpc.example.com
NATIVE_RPC_WS_URL=wss://rpc.example.com
NATIVE_SWAGGER_HTTP_URL=https://api.example.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/native_indexer?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# CoinMarketCap
COIN_MARKET_API_KEY=
COIN_MARKET_API_PATH=https://pro-api.coinmarketcap.com/v1/cryptocurrency/quotes/latest

# Feature flags
CATCHUP_DISABLED=0
TTL_TIME_FOR_REWARDS=4

# WebSocket CORS — comma-separated list of allowed origins; use * to allow all
WS_CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Logging
LOG_LEVEL=info
