            "type": "object",
            "properties": {
               "blockNumber": {
                  "type": "string"
               },
               "blockHash": {
                  "type": "string"
               },
               "timeStamp": {
                  "type": "string"
               },
               "miner": {
                  "type": "string"
               },
               "transactionCount": {
                  "type": "string"
               },
               "createdAt": {
                  "type": "string"
               }
            }
         },
         "transactions": {
            "type": "object",
            "properties": {
               "blocknumber": {
                  "type": "string"
               },
               "blockhash": {
                  "type": "string"
               },
               "stateRoot": {
                  "type": "string"
               },
               "txhash": {
                  "type": "string"
               },
               "contractAddress": {
                  "type": "string"
               },
               "status": {
                  "type": "string"
               },
               "type": {
                  "type": "string"
               },
               "fromAddress": {
                  "type": "string"
               },
               "toAddress": {
                  "type": "string"
               },
               "timestamp": {
                  "type": "string"
               },
               "maxFeePerGas": {
                  "type": "string"
               },
               "maxPriorityFeePerGas": {
                  "type": "string"
               },
               "gasPrice": {
                  "type": "string"
               },
               "gas": {
                  "type": "string"
               },
               "value": {
                  "type": "number"
               },
               "createdAt": {
                  "type": "string"
               },
               "updatedAt": {
                  "type": "string"
               }
            }
         }
      }
   },
