{
   "openapi": "3.0.2",
   "info": {
      "title": "Native service Apis",
      "description": "This service include apis for delegator, validator and native explorer app",
      "version": "1.0.0"
   },
   "produces": [
      "application/json"
   ],
   "servers": [
      {
         "url": "http://localhost:8000/api",
         "description": "Local development server"
      },
      {
         "url": "https://native-api.testnet.stackflow.site/api",
         "description": "Development server"
      }
   ],
