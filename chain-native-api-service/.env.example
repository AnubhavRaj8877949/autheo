# Server
PORT=4003
NODE_ENV=development
# Comma-separated list of allowed CORS origins, or * to allow all
CORS_ALLOWED_ORIGINS=*
# Timeout in milliseconds for outbound HTTP requests
HTTP_TIMEOUT_MS=10000

# Database
DATABASE_URL='postgresql://user:password@localhost:5432/native_db?schema=public'

# Redis
REDIS_URL='redis://guest:guest@localhost:6379'

# RabbitMQ
RABBITMQ_URL='amqp://guest:guest@localhost:5672'

# Blockchain
ADDRESS_PREFIX=''
TOKEN_SYMBOL='ABC'
SWAGGER_HTTP_HOST=''
NATIVE_RPC_HTTP_URL=''
RPC_TIMEOUT_MS=10000
VALIDATORS=''
EXCLUDING_VALIDATORS=''

# Staking
TTL_TIME_FOR_REWARDS=1

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
