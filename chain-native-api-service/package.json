{
  "name": "native-api-service",
  "version": "1.0.0",
  "description": "",
  "main": "build/src/server.js",
  "types": "./types/global.d.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "start": "ts-node ./src/server.ts",
    "build": "npm run lint && tsc -p . && cp .env ./build/.env && cp .env.local ./build/.env.local",
    "build:test": "npm run lint && tsc -p . && cp .env ./build/.env && cp .env.test ./build/.env.test",
    "build:prod": "tsc -p .",
    "build:stag": "npm run lint && tsc -p . && cp .env ./build/.env && cp .env.stag ./build/.env.stag",
    "start:local": "npm run lint && NODE_ENV=local nodemon index.js",
    "start:test": "NODE_ENV=test node build/src/server.js",
    "start:staging": "NODE_ENV=staging node build/src/server.js",
    "start:production": "NODE_ENV=production node build/src/server.js",
    "lint": "eslint src/**/*.ts",
    "lint-fix": "eslint --fix src/**/*.ts",
    "pretty": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install",
    "precommit": "npm run lint-fix && npm run pretty",
    "prepush": "npm run lint ",
    "test:custom": "npm test --  tests/unit-tests/environments/environment.spec.ts",
    "test": "NODE_ENV=test jest --coverage",
    "test:watch": "jest --watch",
    "generate": "npm -s run generate:prisma && npm -s run generate:nexus",
    "generate:prisma": "prisma generate",
    "generate:nexus": "ts-node --transpile-only src/schema",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "author": "",
  "license": "",
  "dependencies": {
    "@cosmjss/encoding": "^0.0.4",
    "@cosmjss/proto-signing": "^0.0.4",
    "@cosmjss/stargate": "^0.0.4",
    "@cosmjss/tendermint-rpc": "^0.0.4",
    "@cosmjss/utils": "^0.0.4",
    "@prisma/client": "^5.22.0",
    "amqplib": "^0.10.3",
    "axios": "^1.16.1",
    "bech32": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.10.2",
    "redis": "^4.6.10",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.10.0"
  },
  "overrides": {
    "protobufjs": "8.0.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.7.2",
    "@types/supertest": "^2.0.12",
    "@types/swagger-ui-express": "^4.1.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^8.45.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.6.1",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^13.2.3",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
